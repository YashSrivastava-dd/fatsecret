FATSECRET_CLIENT_ID=your_client_id_here
FATSECRET_CLIENT_SECRET=your_client_secret_here
# Optional: change the server port
PORT=3000

# Region for food data (defaults to IN = India if not set)
# Note: Localization is a premium FatSecret feature
# Common region codes:
#   IN = India, US = United States, GB = United Kingdom
#   AU = Australia, CA = Canada, SG = Singapore, MY = Malaysia
#   ID = Indonesia, PH = Philippines, TH = Thailand, PK = Pakistan
# Full list: https://platform.fatsecret.com/docs/guides/localization
FATSECRET_REGION=IN

# Optional: Override the default language for the region
# Examples: en, en-UK (English Regional), hi (not available - English used for India)
# FATSECRET_LANGUAGE=en
